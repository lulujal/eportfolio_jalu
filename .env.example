PORT=3000

# Pengaturan Basis Data (Sequelize ORM)
# Gunakan 'postgres' untuk menghubungkan ke PostgreSQL lokal/cloud
# Atau gunakan 'sqlite' untuk database lokal tanpa instalasi server DB
DB_DIALECT=sqlite

# Konfigurasi jika menggunakan PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eportfolio_guru
DB_USER=postgres
DB_PASSWORD=postgres

# Atau gunakan connection string PostgreSQL langsung:
# DATABASE_URL=postgresql://user:password@localhost:5432/eportfolio_guru
